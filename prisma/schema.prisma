generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
  DEFERRED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  NONE
}

enum EnergyLevel {
  HIGH
  MEDIUM
  LOW
}

enum Context {
  HOME
  WORK
  ERRANDS
  COMPUTER
  PHONE
  ANYWHERE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum GoalTimeframe {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  LONG_TERM
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum FocusSessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum PlanItemBucket {
  TOP
  SECONDARY
  OPTIONAL
}

enum ReminderType {
  DEADLINE
  NUDGE
  FOLLOW_UP
}

enum Mood {
  GREAT
  GOOD
  OKAY
  BAD
  TERRIBLE
}

// ─── Models ──────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#6366f1")
  icon      String?
  tasks     Task[]
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#8b5cf6")
  tasks     TaskTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Task {
  id               String              @id @default(cuid())
  title            String
  description      String?
  notes            String?
  priority         TaskPriority        @default(NONE)
  status           TaskStatus          @default(TODO)
  estimatedMinutes Int?
  actualMinutes    Int?
  deadline         DateTime?
  scheduledDate    DateTime?
  completedAt      DateTime?
  context          Context?
  energyLevel      EnergyLevel?
  isImportant      Boolean             @default(false)
  isUrgent         Boolean             @default(false)
  sortOrder        Int                 @default(0)

  // Recurrence
  isRecurring           Boolean              @default(false)
  recurrenceFrequency   RecurrenceFrequency?
  recurrenceInterval    Int?
  recurrenceDaysOfWeek  Int[]
  recurrenceEndDate     DateTime?

  // Relations
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  goalId String?
  goal   Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // Self-referencing subtasks
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks Task[]  @relation("Subtasks")

  // Blocked-by relation
  blockedBy  Task[] @relation("TaskBlocking")
  blocking   Task[] @relation("TaskBlocking")

  tags          TaskTag[]
  focusSessions FocusSession[]
  planItems     PlanItem[]
  reminders     Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([scheduledDate])
  @@index([deadline])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#6366f1")
  deadline    DateTime?
  sortOrder   Int           @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  goalId String?
  goal   Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)

  tasks      Task[]
  milestones Milestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String?
  isCompleted Boolean  @default(false)
  dueDate     DateTime?
  sortOrder   Int      @default(0)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  goalId String?
  goal   Goal?  @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      GoalStatus    @default(NOT_STARTED)
  timeframe   GoalTimeframe @default(QUARTERLY)
  targetDate  DateTime?
  progress    Float         @default(0)
  color       String        @default("#10b981")

  tasks      Task[]
  projects   Project[]
  milestones Milestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id          String         @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String         @default("#f59e0b")
  frequency   HabitFrequency @default(DAILY)
  targetCount Int            @default(1)

  // Custom frequency
  daysOfWeek Int[]

  // Streak tracking
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastCheckIn   DateTime?
  isActive      Boolean  @default(true)

  entries HabitEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HabitEntry {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  count     Int      @default(1)
  notes     String?

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

model FocusSession {
  id            String             @id @default(cuid())
  status        FocusSessionStatus @default(RUNNING)
  startedAt     DateTime           @default(now())
  pausedAt      DateTime?
  completedAt   DateTime?
  totalSeconds  Int                @default(0)
  pausedSeconds Int                @default(0)
  notes         String?

  taskId String?
  task   Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyPlan {
  id         String     @id @default(cuid())
  date       DateTime   @unique @db.Date
  notes      String?
  isComplete Boolean    @default(false)

  items      PlanItem[]
  timeBlocks TimeBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanItem {
  id        String         @id @default(cuid())
  bucket    PlanItemBucket @default(SECONDARY)
  sortOrder Int            @default(0)
  isComplete Boolean       @default(false)

  planId String
  plan   DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, taskId])
}

model TimeBlock {
  id        String   @id @default(cuid())
  startTime String   // "09:00" format
  endTime   String   // "10:30" format
  label     String?

  planId String
  plan   DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  taskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyReview {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  mood           Mood?
  energyLevel    EnergyLevel?
  tasksCompleted Int      @default(0)
  tasksPlanned   Int      @default(0)
  focusMinutes   Int      @default(0)
  wins           String[]
  challenges     String[]
  notes          String?
  gratitude      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReview {
  id              String   @id @default(cuid())
  weekStart       DateTime @unique @db.Date
  tasksCompleted  Int      @default(0)
  tasksCreated    Int      @default(0)
  focusMinutes    Int      @default(0)
  habitsCompleted Int      @default(0)
  habitsMissed    Int      @default(0)
  topWins         String[]
  challenges      String[]
  lessonsLearned  String[]
  nextWeekFocus   String[]
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reminder {
  id          String       @id @default(cuid())
  type        ReminderType @default(NUDGE)
  message     String?
  triggerAt   DateTime
  isSent      Boolean      @default(false)
  isDismissed Boolean      @default(false)

  taskId String?
  task   Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([triggerAt, isSent])
}
